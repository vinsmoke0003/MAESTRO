  "cards": [
    {
      "dot": "rose",
      "title": "Safety rules the flow enforces",
      "items": [
        "No LLM is called anywhere in maestro/safety/",
        "registry.py is closed: 28 verbs, 2 hard-blocked with no executor",
        "Dry run happens before consent; the plan cannot grow after it",
        "ok=True is not success: verifier.py checks the real filesystem"
      ]
    },
    {
      "dot": "cyan",
      "title": "Files beside the main path",
      "items": [
        "ir/model.py: the typed Plan / Action contract every layer passes",
        "agents/summarizer.py: tool-less reader for untrusted file text",
        "safety/budget.py: static and per-step limits inside run()",
        "config.py: workspace, model and bulk threshold from env vars"
      ]
    },
    {
      "dot": "amber",
      "title": "Same path for every caller",
      "items": [
        "cli.py, ui.py and eval/harness.py all call pipeline.handle()",
        "So the benchmark measures the code a user actually runs"
      ]
    }
  ]
