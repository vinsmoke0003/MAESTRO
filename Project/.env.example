# MAESTRO configuration. Copy to `.env` and edit; `.env` is gitignored.
#
# Every value here has a working default. MAESTRO runs with none of them set:
# no model, no key, no network. These only widen what it can do.

# --- where state lives -----------------------------------------------------
# Audit log, episode store, learned preferences, LLM response cache.
# MAESTRO_HOME=~/.maestro
# The agent's own writable root. Also an allowlisted path.
# MAESTRO_WORKSPACE=~/maestro_workspace

# --- planner backend -------------------------------------------------------
# auto   (default) use Ollama if it is actually reachable, else the rule planner
# ollama force Ollama; error if unreachable
# openai force an OpenAI-compatible endpoint (evaluation baselines only)
# none   force no LLM at all
# MAESTRO_LLM=auto

# Local model, via `ollama pull <name>`.
# MAESTRO_MODEL=qwen2.5:7b-instruct-q4_K_M
# MAESTRO_LLM_BASE=http://127.0.0.1:11434

# --- cloud baselines (docs/07 §4 B4/M5) ------------------------------------
# For the frontier upper-bound row ONLY. Nothing in the critical path requires
# a cloud provider, and the offline demo must keep working without one.
#
# PRIVACY WARNING, and it belongs in the report: a desktop agent's prompts
# contain your file paths and folder structure. Free tiers are frequently free
# *because* the provider may train on submitted data. Sending your directory
# layout to one is a real leak — and it is precisely the argument for the
# local-first default.
#
# MAESTRO_LLM=openai
# MAESTRO_LLM_BASE=https://api.groq.com/openai/v1
# MAESTRO_MODEL=llama-3.3-70b-versatile
# MAESTRO_API_KEY=

# --- safety knobs (the ablation harness sweeps these) ----------------------
# Files touched in one action above which it counts as bulk and escalates to R2.
# MAESTRO_BULK_N=25

# --- evaluation ------------------------------------------------------------
# Let the harness run app.launch / app.quit / volume tasks. These open and close
# REAL applications and cannot be sandboxed, so they are off by default. Turn
# them on only on a dedicated evaluation machine.
# MAESTRO_EVAL_DESKTOP=0

# Override the trained intent classifier artifact.
# MAESTRO_INTENT_MODEL=models/intent/intent_clf.joblib
