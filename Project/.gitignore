*.db

# models & large artifacts — reproducible, never committed
*.gguf
*.safetensors
models/planner-lora/
chroma_db/

# The trained intent classifier IS committed: it is ~1 MB, it is what makes a
# fresh clone work without a training step, and `make train-intent` regenerates
# it deterministically. models/intent/ is deliberately NOT ignored.

# generated fine-tuning files — rebuild with `make prepare-lora`
training/data/

# raw evaluation records — large, and regenerated by `make eval`
eval/results/raw/

# scratch
.tmpstate/
.tmpws/
.eval_tmp/
.DS_Store
Thumbs.db
